{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew test*)",
      "Bash(./gradlew build*)",
      "Bash(bun test*)",
      "Bash(bun run typecheck*)",
      "Bash(bun run build*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(git push*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowWrite": [
        "~/.gradle",
        "~/.m2",
        "~/.bun"
      ],
      "denyRead": [
        "./.env",
        "./secrets"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "repo.maven.apache.org",
        "repo1.maven.org",
        "plugins.gradle.org",
        "plugins-artifacts.gradle.org",
        "services.gradle.org",
        "downloads.gradle.org",
        "registry.npmjs.org"
      ]
    }
  }
}
